<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>my.adhd</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- myadhd://dump?text=… , and the address Supabase redirects back to
	     once Google is done. See GoogleSignIn.swift. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>my.adhd</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>myadhd</string>
			</array>
		</dict>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Saves the export question later: nothing here uses encryption
	     beyond the HTTPS every app gets for free. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- hold-to-talk, in voice.js. The shell grants the web view's request;
	     iOS still asks the user, using this sentence.

	     There is deliberately no NSSpeechRecognitionUsageDescription beside
	     it. Adding one switches on the web view's SpeechRecognition, which
	     voice.js uses for the rough live preview — and that engine takes
	     exactly one language, which app.html fixes at English by way of
	     <html lang="en">. A Malay sentence therefore arrived as confident
	     English nonsense and sat in the box until Gemini replaced it.
	     Without the key the engine is simply absent, which is the case
	     voice.js was written for on an iPhone: the level ring while you
	     hold, and the real transcript when you let go. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Hold the mic button to say what is in your head instead of typing it. The recording is transcribed and then thrown away.</string>

	<!-- Meetings.swift. Off until the switch in Settings is turned on, so
	     this sentence is never shown to somebody who did not ask for it.

	     Only the full-access spelling. iOS 17 split the old
	     NSCalendarsUsageDescription into full and write-only, and there
	     is no read-only request to make: full access IS the read one,
	     write-only being the lesser grant that can add an event and
	     cannot see one. The deployment target is 17.0, so the pre-split
	     key would apply to no build this project produces.

	     Nothing is ever written back. The app reads the day and draws it;
	     turning a meeting into a task copies it into the app's own lists
	     and still leaves the calendar alone. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>my.adhd shows the meetings already on your phone, so your day looks like the day you actually have. Nothing is added, changed or sent anywhere.</string>

	<!-- A static screen cannot know which theme was chosen, so it follows
	     the system and the shell paints the remembered ground a frame later. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- site.webmanifest says portrait, and every screen is built for one
	     column.

	     There was a ~ipad variant here handing the iPad the other three,
	     on the grounds that it can put an app in a landscape split view
	     whether we like it or not. TARGETED_DEVICE_FAMILY is now 1, so
	     there is no iPad build for it to apply to and the key was only
	     saying something untrue. An iPad can still run this in iPhone
	     compatibility mode, where it is a phone-shaped window and this
	     list is the one that governs it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- The app's own face, so the wallpaper is drawn in it rather than
	     in SF. A second copy of fonts/Baloo2-Variable.ttf from the web
	     app: they have to be replaced together, and ios/README.md lists
	     it as one of the promises this shell makes about the site. -->
	<key>UIAppFonts</key>
	<array>
		<string>Baloo2-Variable.ttf</string>
	</array>
</dict>
</plist>
