<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ============================================================
	     Required since 1 May 2024. Without it the upload comes back as
	     ITMS-91053 before a human has looked at anything.

	     It describes THIS BUNDLE ONLY — the Swift in MyADHD/. The widget
	     extension has its own (which declares nothing, on purpose) and
	     DumpShare touches no required-reason API.

	     Since 2026-09-20 this app is native, not a web view, so the code
	     that talks to the server ships in here: sign-in and sync with
	     Supabase, the dump text sent to /api/triage, a recording sent to
	     /api/transcribe, feedback to /api/feedback. NSPrivacyCollectedDataTypes
	     below is still empty from the web-view days and has to be filled
	     in to match App Store Connect's privacy questionnaire, which is
	     the one Review reads. privacy.html on the website is the third
	     copy of the same story and has to agree with both. README.md,
	     "Getting it onto the App Store", has the draft answers.
	     ============================================================ -->

	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No analytics, no advertising, no third-party SDKs. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- This app's own preferences, read back only by this app: the
			     theme (ShellState), text parked from a Shortcut (Inbox), the
			     reminder settings (Reminders), the Done ledger, the calendar
			     choices, and a handful of UI states. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Core/StoreFile.swift reads the modification date of its own
			     document (Library/Application Support/myadhd/myadhd.v1.json)
			     to tell whether something else rewrote it while the app was
			     away. A file inside the app's own container: C617.1. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
